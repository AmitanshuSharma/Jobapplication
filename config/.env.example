# .env.example
# Copy this file to config/.env and fill in your credentials.
# Do not commit config/.env — it is gitignored.
# Never hardcode these values anywhere in source code.

# Telegram Bot API
# Create a bot via @BotFather and obtain the token and your chat ID.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Email (SMTP)
# Use an app password if your provider requires 2FA (e.g., Gmail).
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-email-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
